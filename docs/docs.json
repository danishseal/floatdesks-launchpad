              "asset-classes",
              "glossary"
            ]
          },
          {
            "group": "Project",
            "pages": [
              "roadmap",
              "faq"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "icon": "map",
        "groups": [
          {
            "group": "Quickstart",
            "pages": [
              "guides/quickstart/launch-a-token",
              "guides/quickstart/buy-a-token",
              "guides/quickstart/sell-a-token",
              "guides/quickstart/redeem-a-card"
            ]
          },
          {
            "group": "Understanding",
            "pages": [
              "guides/economics",
              "guides/contract-safety"
            ]
          },
          {
            "group": "Advanced",
            "pages": [
              "guides/going-long",
              "guides/hedging",
              "guides/running-a-liquidator",
              "guides/listing-a-market"
            ]
          }
        ]
      },
      {
        "tab": "Protocol",
        "icon": "cpu",
        "groups": [
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/price-index",
              "concepts/launch-curve",
              "concepts/graduation",
              "concepts/amm",
              "concepts/synth-token",
              "concepts/shorts",
              "concepts/funding",
              "concepts/liquidations",
              "concepts/insurance-fund",
              "concepts/circuit-breaker",
              "concepts/parameters"
            ]
          },
          {
            "group": "Oracle & Relayer",
            "pages": [
              "oracle/architecture",
              "oracle/card-pipeline",
              "oracle/nft-pipeline",
              "oracle/operations"
            ]
          },
          {
            "group": "Program Reference",
            "pages": [
              "reference/pdas",
              "reference/accounts",
              "reference/instructions",
              "reference/events",
              "reference/errors"
            ]
          }
        ]
