      "light": "#FFFFFF",
      "dark": "#0B0D10"
    }
  },
  "logo": {
    "light": "/logo/commas-art-light.png",
    "dark": "/logo/commas-art-dark.png"
  },
  "favicon": "/favicon.png",
  "navbar": {
