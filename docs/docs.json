{
  "$schema": "https://mintlify.com/docs.json",
  "name": "commas",
  "description": "commas is a launchpad for funding-pegged synthetic tokens that track collectible markets: graded trading cards and NFT collection floors. commas.art",
  "theme": "almond",
  "icons": {
    "library": "lucide"
  },
  "colors": {
    "primary": "#171717",
    "light": "#FAFAFA",
    "dark": "#171717"
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "dark": "min-dark",
        "light": "min-light"
      }
    }
  },
  "navigation": {
